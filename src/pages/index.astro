---
import { readFile } from "node:fs/promises";
import path from "node:path";
import Base from "../layouts/Base.astro";
import PipelineVisual from "../components/PipelineVisual.astro";
import { OFFICIAL } from "../lib/site";

// 真实计数：解析各手册「全表/清单」类表格（表头含 名称 + 支持/平台/用途）的名称列条目数
async function listEntries(file: string): Promise<number> {
  try {
    const src = await readFile(
      path.resolve(process.cwd(), "src/content/docs", file),
      "utf8"
    );
    let count = 0;
    let inList = false;
    for (const l of src.split(/\r?\n/)) {
      const row = l.trim();
      if (!row.startsWith("|")) {
        inList = false;
        continue;
      }
      const cells = row.split("|").slice(1, -1).map((c) => c.trim());
      if (cells.some((c) => c.includes("名称")) && cells.some((c) => /支持|平台|用途/.test(c))) {
        inList = true;
        continue;
      }
      if (!inList) continue;
      if (cells.every((c) => /^-{2,}:*$/.test(c))) continue; // 分隔行
      const nameCols = cells.length >= 7 ? [cells[0], cells[3]] : [cells[0]];
      for (const cell of nameCols) {
        const cleaned = cell.replace(/`/g, "");
        for (const tok of cleaned.split(/[,，]/)) {
          if (tok.trim()) count++;
        }
      }
    }
    return count;
  } catch {
    return 0;
  }
}
const fmt = await listEntries("formats.mdx");
const cod = await listEntries("codecs.mdx");
const flt = await listEntries("filters.mdx");
const dev = await listEntries("devices.mdx");

const recipes = [
  {
    zh: "格式转换",
    code: ["ffmpeg -i input.mp4 output.avi"],
  },
  {
    zh: "抽取指定流",
    code: ["ffmpeg -i INPUT -map 0:1 out.wav"],
  },
  {
    zh: "截取片段",
    code: ["ffmpeg -i INPUT -vf trim=60:120"],
  },
  {
    zh: "改变尺寸",
    code: ["ffmpeg -i infile -vf scale=640:360 outfile"],
  },
  {
    zh: "压制体积",
    code: ["ffmpeg -i input.avi -b:v 64k -bufsize 64k output.mp4"],
  },
  {
    zh: "强制帧率",
    code: ["ffmpeg -i input.avi -r 24 output.mp4"],
  },
] as const;

const highlights = [
  { name: "xHE-AAC 解码", note: "Mps212 实验性解码与 MPEG-H 外部库接入" },
  { name: "EXIF 元数据", note: "解析并转发图像 EXIF" },
  { name: "Vulkan 计算编解码", note: "ProRes 编解码、DPX 解码不再依赖运行时 GLSL 编译" },
  { name: "D3D12 硬件路径", note: "H.264/AV1 编码与 scale/deinterlace 等滤镜" },
  { name: "Rockchip 编码", note: "H.264/HEVC 硬件编码支持" },
  { name: "IAMF 沉浸音频", note: "Ambisonic 元素的混流与解流" },
];

const timeline = [
  { v: "8.1", name: "Hoare", d: "2026-03-16", now: true },
  { v: "8.0", name: "Huffman", d: "2025-08-22" },
  { v: "7.1", name: "Péter", d: "2024-09-30" },
  { v: "7.0", name: "Dijkstra", d: "2024-04-05" },
  { v: "6.1", name: "Heaviside", d: "2023-11-10" },
];
---

<Base
  title="FFmpeg：录制、转换与流化音视频的完整方案"
  description="FFmpeg 中文站：开源多媒体框架与命令行工具的完整文档。转码、剪辑、混流、推流，一条命令完成。"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "FFmpeg",
    applicationCategory: "MultimediaApplication",
    softwareVersion: "8.1",
    operatingSystem: "Linux, macOS, Windows, Android, iOS",
    license: { "@type": "CreativeWork", name: "LGPL-2.1-or-later / GPL-2.0-or-later" },
    url: "https://ffmpeg.org/",
  })}></script>

  <!-- 首屏：不对称分屏 -->
  <section class="mx-auto grid max-w-[1280px] items-center gap-12 px-4 pb-16 pt-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] lg:gap-10 lg:pb-24 lg:pt-16">
    <div>
      <p class="font-mono text-[13px] text-ink-3">
        <span class="text-accent">$</span> ffmpeg | ffprobe | ffplay
      </p>
      <h1 class="mt-4 text-[2.1rem] font-bold leading-[1.15] tracking-tight sm:text-5xl lg:text-[3.4rem]">
        录制、转换与流化音视频的<span class="text-accent">完整方案</span>
      </h1>
      <p class="mt-5 max-w-[40ch] text-[17px] leading-relaxed text-ink-2">
        FFmpeg 是开源多媒体框架。几乎每一种容器与编解码器都在它的管线之中，一条命令即可完成转码、剪辑、混流与推流。
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/docs/download/"
          class="rounded-full bg-accent px-6 py-3 text-[15px] font-bold text-accent-ink transition-transform active:scale-[0.98]"
        >
          下载 FFmpeg 8.1
        </a>
        <a
          href="/docs/"
          class="rounded-full border border-line-strong px-6 py-3 text-[15px] font-medium text-ink transition-colors hover:border-accent hover:text-accent"
        >
          阅读文档
        </a>
      </div>
    </div>
    <div class="min-w-0">
      <PipelineVisual />
    </div>
  </section>

  <!-- 七个库：三个分簇，核心簇为实心品牌绿 -->
  <section class="mx-auto max-w-[1280px] px-4 py-16 sm:px-6 lg:py-20">
    <h2 class="max-w-[18ch] text-2xl font-bold tracking-tight sm:text-3xl">
      一个框架，七个库
    </h2>
    <p class="mt-3 max-w-[52ch] text-ink-2">
      上层是三条命令行工具，下层是七块互相咬合的零件。它们也作为开发库供你直接嵌入自己的程序。
    </p>
    <div class="mt-10 grid gap-4 lg:grid-cols-[1.15fr_1.15fr_0.7fr]">
      <div class="rounded-tile bg-accent p-6 text-accent-ink sm:p-8">
        <p class="text-[15px] font-bold opacity-80">核心</p>
        <ul class="mt-4 space-y-4">
          {
            [
              ["libavcodec", "大量编解码器的实现"],
              ["libavformat", "流媒体协议、容器格式与基础 I/O"],
              ["libavutil", "哈希、压缩与各类实用函数"],
            ].map(([n, d]) => (
              <li>
                <p class="font-mono text-[15px] font-medium">{n}</p>
                <p class="mt-0.5 text-[14px] leading-relaxed opacity-85">{d}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-tile border border-line bg-surface p-6 sm:p-8">
        <p class="text-[15px] font-bold text-ink-3">处理</p>
        <ul class="mt-4 space-y-4">
          {
            [
              ["libavfilter", "以有向图串联滤镜，改写解码后的音视频"],
              ["libswscale", "色彩空间转换与图像缩放"],
              ["libswresample", "音频重采样与混音"],
            ].map(([n, d]) => (
              <li>
                <p class="font-mono text-[15px] font-medium text-accent">{n}</p>
                <p class="mt-0.5 text-[14px] leading-relaxed text-ink-2">{d}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col justify-between rounded-tile border border-line bg-elevated p-6 sm:p-8">
        <div>
          <p class="text-[15px] font-bold text-ink-3">设备</p>
          <p class="mt-4 font-mono text-[15px] font-medium text-accent">libavdevice</p>
          <p class="mt-1 text-[14px] leading-relaxed text-ink-2">
            采集与播放设备的抽象层：声卡、摄像头、屏幕抓取都在内。
          </p>
        </div>
        <div class="mt-6 flex gap-3 text-ink-3" aria-hidden="true">
          <i class="ph ph-camera text-[26px]"></i>
          <i class="ph ph-monitor text-[26px]"></i>
          <i class="ph ph-speaker-high text-[26px]"></i>
          <i class="ph ph-microphone text-[26px]"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- 三条工具：大格 + 两小格 -->
  <section class="mx-auto max-w-[1280px] px-4 py-16 sm:px-6 lg:py-20">
    <div class="grid gap-4 lg:grid-cols-[1.35fr_1fr] lg:items-stretch">
      <a href="/docs/ffmpeg/" class="group flex min-w-0 flex-col justify-between rounded-tile border border-line bg-surface p-6 transition-colors hover:border-line-strong sm:p-8">
        <div>
          <p class="font-mono text-[19px] font-bold text-ink group-hover:text-accent">ffmpeg</p>
          <p class="mt-2 max-w-[40ch] text-[15px] leading-relaxed text-ink-2">
            命令行工具箱：转码、剪辑、混流、滤镜、采集与推流，全靠它。管线里每个环节都能用选项精确控制。
          </p>
        </div>
        <pre class="mt-6 overflow-x-auto rounded-code border border-line bg-elevated px-4 py-3 font-mono text-[13px] leading-relaxed text-ink-2"><code>$ ffmpeg -i concert.mkv -vf 'crop=ih*16/9:ih' -c:v libx264 -crf 20 cut.mp4</code></pre>
      </a>
      <div class="grid min-w-0 gap-4">
        <a href="/docs/ffprobe/" class="group rounded-tile border border-line bg-surface p-6 transition-colors hover:border-line-strong">
          <p class="font-mono text-[16px] font-bold text-ink group-hover:text-accent">ffprobe</p>
          <p class="mt-1.5 text-[14px] leading-relaxed text-ink-2">
            检视多媒体内容：流、编码、码率、时间戳，可输出 JSON 给脚本消费。
          </p>
          <p class="mt-3 font-mono text-[12.5px] text-ink-3">$ ffprobe -hide_banner in.mkv</p>
        </a>
        <a href="/docs/ffplay/" class="group rounded-tile border border-line bg-surface p-6 transition-colors hover:border-line-strong">
          <p class="font-mono text-[16px] font-bold text-ink group-hover:text-accent">ffplay</p>
          <p class="mt-1.5 text-[14px] leading-relaxed text-ink-2">
            极简播放器：任何 FFmpeg 能解开的东西，一条命令就能放出来。
          </p>
          <p class="mt-3 font-mono text-[12.5px] text-ink-3">$ ffplay rtsp://camera/live</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 常用命令：横向 scroll-snap 胶囊 -->
  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">高频操作，一句话命令</h2>
          <p class="mt-3 max-w-[46ch] text-ink-2">全部取自官方手册与示例。拖横向列表，或去快速上手页看完整版。</p>
        </div>
        <a href="/docs/quickstart/" class="hidden shrink-0 items-center gap-1.5 text-[15px] font-medium text-accent hover:underline sm:inline-flex">
          快速上手
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
    <div class="relative mt-8">
      <div
        id="recipe-scroll"
        class="recipes-scroll flex snap-x gap-4 overflow-x-auto px-4 pb-5 sm:px-6"
        role="list"
        tabindex="0"
        aria-label="常用命令列表，可横向滚动"
      >
        {
          recipes.map((r, i) => (
            <div
              role="listitem"
              class:list={[
                "w-[440px] shrink-0 snap-start rounded-tile border border-line p-5",
                i % 3 === 0 ? "bg-elevated" : "bg-surface",
              ]}
            >
              <p class="text-[15px] font-bold">{r.zh}</p>
              <pre class="mt-3 min-h-[65px] whitespace-pre-wrap break-normal rounded-code border border-line bg-bg px-3.5 py-3 font-mono text-[12px] leading-relaxed text-ink-2"><code>{r.code.join("\n")}</code></pre>
            </div>
          ))
        }
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-bg to-transparent"
        aria-hidden="true"
      ></div>
    </div>

    <style>
      #recipe-scroll {
        scrollbar-width: thin;
        scrollbar-color: var(--color-line-strong) transparent;
      }
      #recipe-scroll::-webkit-scrollbar {
        height: 10px;
      }
      #recipe-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      #recipe-scroll::-webkit-scrollbar-thumb {
        background: var(--color-line-strong);
        border-radius: 999px;
      }
      #recipe-scroll:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
      }
    </style>
  </section>

  <!-- 版本与动态：左焦点卡 + 右时间线 -->
  <section class="mx-auto max-w-[1280px] px-4 py-16 sm:px-6 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">最新发行</h2>
        <div class="mt-6 rounded-tile border-2 border-accent bg-surface p-6 sm:p-8">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <p class="font-mono text-[22px] font-bold">FFmpeg 8.1 <span class="text-accent">"Hoare"</span></p>
            <p class="text-[13px] text-ink-3">2026-03-16 发布</p>
          </div>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {
              highlights.map((h) => (
                <li class="border-l-2 border-accent pl-3">
                  <p class="text-[14px] font-bold">{h.name}</p>
                  <p class="mt-0.5 text-[13px] leading-relaxed text-ink-2">{h.note}</p>
                </li>
              ))
            }
          </ul>
          <a href="/docs/releases/" class="mt-6 inline-flex items-center gap-1.5 text-[15px] font-medium text-accent hover:underline">
            查看完整亮点与历史
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      <div class="lg:pt-[4.6rem]">
        <h2 class="sr-only">版本时间线</h2>
        <ol class="space-y-0">
          {
            timeline.map((t) => (
              <li class="flex items-baseline gap-4 border-b border-line py-4">
                <span class:list={["font-mono text-[17px] font-bold", t.now ? "text-accent" : "text-ink"]}>
                  {t.v}
                </span>
                <span class="text-[15px] text-ink-2">"{t.name}"</span>
                <span class="ml-auto font-mono text-[13px] text-ink-3">{t.d}</span>
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-[14px] text-ink-2">
          大版本约每半年一发，代号都是计算机科学人物。
          <a href="/docs/releases/" class="text-accent underline underline-offset-4 hover:underline">更早的版本</a>
          与项目动态也在这页。
        </p>
      </div>
    </div>
  </section>

  <!-- 数据带 -->
  <section class="border-y border-line bg-surface">
    <div class="mx-auto grid max-w-[1280px] grid-cols-2 gap-y-10 px-4 py-14 sm:px-6 lg:grid-cols-4">
      <div class="lg:pl-4">
        <p class="font-mono text-4xl font-bold text-accent">7+3</p>
        <p class="mt-2 text-[14px] leading-snug text-ink-2">七个开发库，三条命令行工具</p>
      </div>
      <div>
        <p class="font-mono text-4xl font-bold">{fmt + cod}</p>
        <p class="mt-2 text-[14px] leading-snug text-ink-2">
          本站手册已收录的格式与编解码器条目
        </p>
      </div>
      <div>
        <p class="font-mono text-4xl font-bold">{flt}</p>
        <p class="mt-2 text-[14px] leading-snug text-ink-2">
          滤镜条目（音视频全清单见
          <a href="/docs/filters/" class="underline underline-offset-4 hover:text-accent"> 滤镜手册</a>）
        </p>
      </div>
      <div>
        <p class="font-mono text-4xl font-bold">{dev}</p>
        <p class="mt-2 text-[14px] leading-snug text-ink-2">
          采集与播放设备条目
        </p>
      </div>
    </div>
  </section>

  <!-- 社区 -->
  <section class="mx-auto max-w-[1280px] px-4 py-16 sm:px-6 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">社区驱动</h2>
        <p class="mt-3 max-w-[42ch] text-ink-2">
          FFmpeg 由全球志愿者维护，靠捐赠与基金会资助运转。补丁经邮件列表评审，而非拉取请求。本站文档同样欢迎勘误。
        </p>
        <a
          href={OFFICIAL.donate}
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-[15px] font-bold text-accent-ink transition-transform active:scale-[0.98]"
          rel="noopener"
          target="_blank"
        >
          <i class="ph ph-heart-bold text-[16px]" aria-hidden="true"></i>
          捐赠 FFmpeg 项目
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          [
            {
              icon: "ph-envelope-simple",
              zh: "ffmpeg-devel 邮件列表",
              d: "开发与补丁讨论的主阵地",
              href: OFFICIAL.list,
            },
            {
              icon: "ph-chats-circle",
              zh: "IRC #ffmpeg",
              d: "Libera 频道，实时答疑",
              href: OFFICIAL.irc,
            },
            {
              icon: "ph-book-open-text",
              zh: "官方 Wiki",
              d: "海量实战技巧与疑难杂症",
              href: OFFICIAL.wiki,
            },
            {
              icon: "ph-git-fork",
              zh: "源码与 Forge",
              d: "code.ffmpeg.org 与 git 镜像",
              href: OFFICIAL.code,
            },
          ].map((c) => (
            <a
              href={c.href}
              rel="noopener"
              target="_blank"
              class="group rounded-tile border border-line bg-surface p-5 transition-colors hover:border-line-strong"
            >
              <i class:list={["ph block text-[24px] text-accent", c.icon]} aria-hidden="true"></i>
              <p class="mt-3 text-[15px] font-bold group-hover:text-accent">{c.zh}</p>
              <p class="mt-1 text-[13.5px] text-ink-2">{c.d}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
