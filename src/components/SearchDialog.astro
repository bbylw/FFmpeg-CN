---
---
<div
  id="search-root"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label="文档搜索"
>
  <div id="search-backdrop" class="absolute inset-0 bg-bg/80 backdrop-blur-sm"></div>
  <div
    class="relative mx-auto mt-[12vh] w-[min(640px,calc(100vw-2rem))] overflow-hidden rounded-tile border border-line bg-elevated shadow-2xl shadow-black/30"
  >
    <div class="flex items-center gap-3 border-b border-line px-4">
      <i class="ph ph-magnifying-glass text-[18px] text-ink-3" aria-hidden="true"></i>
      <input
        id="search-input"
        type="search"
        role="combobox"
        aria-label="搜索文档关键词"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        class="w-full bg-transparent py-3.5 text-[15px] text-ink outline-none placeholder:text-ink-3"
        placeholder="搜索文档，如：硬件加速、截取片段、overlay"
        autocomplete="off"
      />
      <!-- 原生 search 的清除叉号在暗色下几乎不可见，换成同色系的按钮 -->
      <button
        id="search-clear"
        type="button"
        class="hidden h-6 w-6 shrink-0 items-center justify-center rounded-full text-ink-3 transition hover:bg-accent-soft hover:text-ink sm:flex"
        aria-label="清空搜索词"
      >
        <i class="ph ph-x text-[13px]" aria-hidden="true"></i>
      </button>
      <kbd class="hidden font-mono text-[11px] text-ink-3 sm:block">Esc</kbd>
    </div>
    <div id="search-status" class="px-4 py-3 text-[13px] text-ink-3" role="status">
      输入关键词开始搜索。
    </div>
    <ul
      id="search-results"
      class="thin-scroll max-h-[52vh] overflow-y-auto p-2"
      role="listbox"
      aria-label="搜索结果"
    ></ul>
  </div>
</div>

<style is:global>
  #search-root::backdrop {
    display: none;
  }
  #search-input::-webkit-search-cancel-button,
  #search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
  .search-hit mark {
    background: color-mix(in oklab, var(--color-accent) 30%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
</style>

<script>
  type Hit = { t: string; s: string; h: string; u: string; x: string };
  let INDEX: Hit[] | null = null;

  const root = document.getElementById("search-root");
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const status = document.getElementById("search-status");
  const list = document.getElementById("search-results");
  const clearBtn = document.getElementById("search-clear");

  // 键盘导航状态：options 是当前渲染出的结果链接，active 为高亮下标（-1 表示无）
  let lastFocus: HTMLElement | null = null;
  let options: HTMLAnchorElement[] = [];
  let active = -1;

  const setActive = (i: number) => {
    if (!options.length) return;
    active = ((i % options.length) + options.length) % options.length;
    options.forEach((a, n) => {
      const on = n === active;
      a.setAttribute("aria-selected", String(on));
      a.classList.toggle("bg-accent-soft", on);
    });
    input?.setAttribute("aria-activedescendant", options[active].id);
    options[active].scrollIntoView({ block: "nearest" });
  };

  const clearActive = () => {
    active = -1;
    for (const a of options) {
      a.setAttribute("aria-selected", "false");
      a.classList.remove("bg-accent-soft");
    }
    input?.removeAttribute("aria-activedescendant");
  };

  const isOpen = () => !!root && !root.classList.contains("hidden");

  const open = () => {
    if (!root || isOpen()) return;
    lastFocus = (document.activeElement as HTMLElement | null) ?? null;
    root.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    input?.focus();
    ensureIndex();
  };

  const close = () => {
    if (!root || !isOpen()) return;
    root.classList.add("hidden");
    document.body.style.overflow = "";
    // 焦点还给触发者（搜索按钮 / 404 页按钮），否则键盘用户会掉到文档开头
    lastFocus?.focus();
    lastFocus = null;
  };

  async function ensureIndex() {
    if (INDEX || !status) return;
    try {
      status.textContent = "正在加载索引……";
      const res = await fetch("/search-index.json");
      INDEX = (await res.json()) as Hit[];
      status.textContent = INDEX.length ? "输入关键词开始搜索。" : "索引为空。";
    } catch {
      status.textContent = "索引加载失败，可稍后重试或直接浏览文档目录。";
    }
  }

  function esc(s: string) {
    return s.replace(/[&<>"]/g, (c) =>
      c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === ">" ? "&gt;" : "&quot;"
    );
  }

  function search(qRaw: string) {
    if (!INDEX || !list || !status) return;
    const q = qRaw.trim().toLowerCase();
    list.innerHTML = "";
    options = [];
    clearActive();
    if (!q) {
      status.textContent = "输入关键词开始搜索。";
      return;
    }
    const terms = q.split(/\s+/).filter(Boolean);
    const scored: { hit: Hit; score: number; ctx: string }[] = [];
    for (const hit of INDEX) {
      let score = 0;
      let ctx = "";
      const title = hit.t.toLowerCase();
      const sect = hit.s.toLowerCase();
      const body = hit.x.toLowerCase();
      let allFound = true;
      for (const term of terms) {
        let t = 0;
        if (title.includes(term)) t += 6;
        if (sect.includes(term)) t += 4;
        const bi = body.indexOf(term);
        if (bi >= 0) {
          t += 2;
          if (!ctx) {
            const from = Math.max(0, bi - 30);
            ctx = (from > 0 ? "…" : "") + hit.x.slice(from, bi + term.length + 60) + "…";
          }
        }
        if (t === 0) allFound = false;
        score += t;
      }
      if (allFound && score > 0) scored.push({ hit, score, ctx });
    }
    scored.sort((a, b) => b.score - a.score);
    const top = scored.slice(0, 12);
    // 两个数字都是「节」的数量，此前写成「命中 3 节（共 12 处）」会让人以为是命中次数
    status.textContent = scored.length
      ? scored.length > top.length
        ? `共 ${scored.length} 节匹配，显示前 ${top.length} 条`
        : `命中 ${scored.length} 节`
      : `没有匹配「${qRaw.trim()}」的内容。`;
    top.forEach(({ hit, ctx }, i) => {
      const li = document.createElement("li");
      li.setAttribute("role", "presentation");
      const a = document.createElement("a");
      a.id = `search-option-${i}`;
      a.href = hit.u;
      a.setAttribute("role", "option");
      a.setAttribute("aria-selected", "false");
      a.className = "search-hit block rounded-lg px-3 py-2.5 hover:bg-accent-soft";
      const ctxHtml = ctx ? markTerms(ctx, terms) : "";
      a.innerHTML =
        `<div class="text-[14px] font-medium text-ink">${esc(hit.t)} <span class="text-ink-3">/</span> ${esc(hit.s)}</div>` +
        (ctxHtml ? `<div class="mt-0.5 line-clamp-2 text-[13px] leading-relaxed text-ink-2">${ctxHtml}</div>` : "");
      li.appendChild(a);
      list.appendChild(li);
      options.push(a);
    });
    if (options.length) setActive(0);
  }

  function markTerms(text: string, terms: string[]) {
    let html = esc(text);
    for (const term of terms) {
      const re = new RegExp(
        term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"),
        "ig"
      );
      html = html.replace(re, (m) => `<mark>${m}</mark>`);
    }
    return html;
  }

  // 清除按钮只在有输入时出现（小屏由 sm:flex 决定是否可见）
  const syncClear = () => {
    if (!clearBtn || !input) return;
    clearBtn.classList.toggle("hidden", input.value.length === 0);
  };

  window.addEventListener("ffmpeg:search", open);
  document.getElementById("search-backdrop")?.addEventListener("click", close);
  input?.addEventListener("input", () => {
    search(input.value);
    syncClear();
  });
  clearBtn?.addEventListener("click", () => {
    if (!input) return;
    input.value = "";
    search("");
    syncClear();
    input.focus();
  });

  // 键盘：上下选结果、回车跳转、Esc 关闭、Tab 锁在对话框内
  const onKeydown = (e: KeyboardEvent) => {
    if (!isOpen()) return;
    switch (e.key) {
      case "Escape":
        e.preventDefault();
        close();
        break;
      case "ArrowDown":
        e.preventDefault();
        setActive(active + 1);
        break;
      case "ArrowUp":
        e.preventDefault();
        setActive(active - 1);
        break;
      case "Home":
        if (options.length) {
          e.preventDefault();
          setActive(0);
        }
        break;
      case "End":
        if (options.length) {
          e.preventDefault();
          setActive(options.length - 1);
        }
        break;
      case "Enter": {
        const target = options[active] ?? options[0];
        if (target) {
          e.preventDefault();
          location.href = target.getAttribute("href") || "";
        }
        break;
      }
      case "Tab": {
        // 焦点锁在对话框内，在输入框与清除按钮之间循环
        const els = ([input, clearBtn] as (HTMLElement | null)[]).filter(
          (el): el is HTMLElement => !!el && !el.classList.contains("hidden")
        );
        e.preventDefault();
        if (els.length < 2) {
          els[0]?.focus();
          break;
        }
        const at = els.indexOf(document.activeElement as HTMLElement);
        const step = e.shiftKey ? -1 : 1;
        els[(at + step + els.length) % els.length].focus();
        break;
      }
    }
  };
  document.addEventListener("keydown", onKeydown);
</script>
